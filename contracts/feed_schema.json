{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScrollForge feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "last_updated",
    "calendar_mode",
    "active_exam_course",
    "cards"
  ],
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "calendar_mode": {
      "enum": [
        "BASELINE",
        "EXAM_WINDOW",
        "CRUNCH_WINDOW",
        "EXAM_DAY"
      ]
    },
    "active_exam_course": {
      "type": [
        "string",
        "null"
      ]
    },
    "cards": {
      "type": "array",
      "maxItems": 1500,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "author",
        "body_markdown",
        "created_at",
        "unread",
        "issue_number"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "enum": [
            "USER",
            "CODEX"
          ]
        },
        "body_markdown": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "unread": {
          "type": "boolean"
        },
        "issue_number": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "category",
        "course_tag",
        "title",
        "body_markdown",
        "solution_markdown",
        "source_url",
        "parent_card_id",
        "comments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "enum": [
            "SPORTS",
            "NEWS",
            "STORY",
            "CHALLENGE_CURRENT",
            "CHALLENGE_PAST",
            "DEEP_CUT",
            "INTEREST"
          ]
        },
        "course_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body_markdown": {
          "type": "string",
          "minLength": 1
        },
        "solution_markdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "parent_card_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "quiz": {
          "anyOf": [
            {
              "$ref": "#/$defs/quiz"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagram": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pipe",
            "pump",
            "tank",
            "cycle",
            "beam",
            "truss",
            "stress",
            "shaft",
            "spring",
            "circuit",
            null,
            "fridge",
            "turbine",
            "beam_eccentric",
            "beam_udl",
            "beam_triangular",
            "vectors",
            "mohr",
            "rectangle",
            "parallel_springs",
            "series_springs",
            "member",
            "axes2d",
            "axes3d",
            "tangent",
            "limit",
            "area",
            "integral",
            "series",
            "circle",
            "polar",
            "revolution",
            "matrix",
            "decay",
            "motion",
            "falling",
            "projectile",
            "forces",
            "wave",
            "charges",
            "field",
            "resistor",
            "capacitor",
            "magnetic",
            "lens",
            "plot",
            "open_tank",
            "sealed_tank",
            "energy_balance",
            "lever",
            "spring_undamped",
            "damper",
            "collision",
            "coil",
            "incline"
          ]
        },
        "diagram_labels": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "topic": {
          "type": "string",
          "maxLength": 100
        },
        "sport": {
          "enum": [
            "football",
            "hockey"
          ]
        },
        "team": {
          "type": "string",
          "maxLength": 100
        },
        "image_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "diagram_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "function",
            "lower",
            "upper",
            "coefficient",
            "label"
          ],
          "properties": {
            "function": {
              "enum": [
                "square",
                "parts",
                "substitution",
                "rational"
              ]
            },
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "upper": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "coefficient": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "chess": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fen",
                "line"
              ],
              "properties": {
                "fen": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "line": {
                  "type": "array",
                  "maxItems": 24,
                  "items": {
                    "type": "string",
                    "maxLength": 12
                  }
                },
                "svg": {
                  "type": "string",
                  "maxLength": 40000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "correct_index"
      ],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "correct_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    }
  }
}
